# =============================================================================
# LIVE MONITOR - VARIÁVEIS DE AMBIENTE (PERSONALIZAÇÃO POR ESCRITÓRIO)
# =============================================================================

# 0. Identidade do Escritório / Empresa (White-Label)
# Este nome aparecerá no cabeçalho das mensagens de WhatsApp e relatórios
OFFICE_NAME="Seu Escritório de Advocacia ou Consultoria"

# 1. Configurações da Caixa Central de E-mail (IMAP com TLS)
# É a caixa de e-mail do seu escritório que recebe os avisos dos clientes via apelido/alias.
# Para Gmail ou Google Workspace:
#   1. Acesse https://myaccount.google.com/security
#   2. Ative "Verificação em duas etapas"
#   3. Em "Senhas de app", crie uma chave com o nome "Live Monitor" e cole abaixo:
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=notificacoes@seu-escritorio.com.br
IMAP_PASSWORD=cole-aqui-a-senha-de-app-de-16-letras
IMAP_USE_SSL=true
IMAP_MAILBOX=INBOX

# 2. WhatsApp Web Automation (Navegador Autônomo)
# WA_HEADLESS: true para rodar silencioso em segundo plano; false para abrir janela
WA_HEADLESS=true
WA_TIMEOUT_MS=45000
WA_DEFAULT_DDI=55
WA_INTERVAL_SECONDS=15

# 3. Inteligência Artificial para Resumos de Intimações
# Opções: anthropic (Claude), gemini (Google) ou heuristic (motor interno sem custo de API)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# 4. Agendamento Automático de Varreduras
# Defina os horários do dia separados por vírgula em que o robô deve checar a caixa:
SCHEDULE_TIMES=08:30,11:30,14:30,17:30,20:00
# Ou defina em minutos se preferir intervalo constante (ex: 30 para rodar a cada meia hora):
SCHEDULE_INTERVAL_MINUTES=0

# 5. Nível de Detalhe dos Logs
LOG_LEVEL=INFO
