# =============================================================================
# LIVE MONITOR - VARIÁVEIS DE AMBIENTE
# =============================================================================

# 1. Configurações da Caixa Central de E-mail (IMAP com TLS)
# Para Gmail/Google Workspace, gere uma "Senha de App" (App Password) em:
# Conta Google -> Segurança -> Verificação em 2 etapas -> Senhas de app
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=monitoramento@consultoria.ecossistemalive.com.br
IMAP_PASSWORD=sua-senha-de-app-aqui
IMAP_USE_SSL=true
IMAP_MAILBOX=INBOX

# 2. WhatsApp Web Automation (Playwright)
# WA_HEADLESS: true para rodar silencioso em background; false para abrir janela
WA_HEADLESS=true
WA_TIMEOUT_MS=45000
WA_DEFAULT_DDI=55
WA_INTERVAL_SECONDS=15

# 3. Motor de Triagem Semântica (IA / Heurística)
# LLM_PROVIDER: anthropic | gemini | heuristic (fallback inteligente sem API)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# 4. Agendamento Autônomo
# Horários fixos ao longo do dia separados por vírgula
SCHEDULE_TIMES=08:30,11:30,14:30,17:30,20:00
# Ou defina um intervalo em minutos (ex: 30 para rodar a cada 30 min, 0 para usar horários fixos)
SCHEDULE_INTERVAL_MINUTES=0

# 5. Logging
LOG_LEVEL=INFO
